---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Adiviath Technologies | Software made to fit"
  description="Adiviath Technologies builds focused software for specific real-world needs. Meet Pharmulo, our ordering platform for pharmaceutical wholesalers."
>
  <section class="hero">
    <div>
      <p class="eyebrow">Adiviath Technologies</p>
      <h1>Rooted in<br />real needs.</h1>
      <p class="hero-copy">
        We make software for the particular ways people work, from online ordering
        for pharmaceutical wholesalers to managing freight bills and payments.
      </p>
      <div class="actions">
        <a class="button" href="/products">See what we build</a>
        <a class="quiet-link" href="/about">Why Adiviath</a>
      </div>
    </div>
    <figure class="product-tree">
      <svg viewBox="0 0 480 520" role="group" aria-labelledby="tree-title tree-desc">
        <title id="tree-title">Products growing from real needs</title>
        <desc id="tree-desc">A cocoa tree with two projects on its branches: Pharmulo and Naveen Logistics. Select a logo to learn more.</desc>
        <path d="M72 341C-1 259 50 166 112 155C91 63 204 22 254 89C341 25 427 102 401 174C485 210 452 316 382 339Z" fill="#f1e5d5"/>
        <g fill="none" stroke="#654332" stroke-linecap="round">
          <path d="M241 411C231 328 265 268 244 159" stroke-width="19"/>
          <path d="M241 312C185 304 143 272 126 219M247 252C293 253 329 221 343 178M245 207C211 199 192 173 190 141" stroke-width="12"/>
          <path d="M239 406C211 420 185 430 165 448M242 406C262 425 295 421 321 442M240 416L238 457" stroke-width="7"/>
        </g>
        <g fill="#ba9b7d">
          <path d="M125 221C86 222 75 188 79 164C112 164 137 188 125 221Z"/>
          <path d="M188 158C155 152 148 118 162 95C191 108 206 136 188 158Z"/>
          <path d="M251 181C250 147 275 127 302 130C302 161 279 180 251 181Z"/>
          <path d="M329 205C319 169 341 145 367 143C381 174 360 200 329 205Z"/>
          <path d="M184 292C173 258 148 250 127 258C131 285 155 301 184 292Z"/>
        </g>
        <path d="M68 412C177 397 299 403 415 412" fill="none" stroke="#d7c3ab" stroke-width="2"/>
        <path d="M310 243V270" stroke="#654332" stroke-width="5" stroke-linecap="round"/>
        <a href="/products#pharmulo" aria-label="Explore Pharmulo" class="tree-fruit">
          <circle cx="310" cy="307" r="43" fill="#fffaf3" stroke="#edab78" stroke-width="3"/>
          <image href="/pharmulo-symbol.svg" x="288" y="283" width="44" height="48" preserveAspectRatio="xMidYMid meet"/>
        </a>
        <path d="M137 255V283" stroke="#654332" stroke-width="5" stroke-linecap="round"/>
        <a href="/products#naveen-logistics" aria-label="Explore the Naveen Logistics project" class="tree-fruit">
          <circle cx="137" cy="326" r="43" fill="#fffaf3" stroke="#edab78" stroke-width="3"/>
          <image href="/naveen-logistics-logo.png" x="109" y="298" width="56" height="56"/>
        </a>
      </svg>
      <figcaption>Different kinds of work. The same roots.</figcaption>
    </figure>
  </section>

  <section class="product-feature">
    <div class="product-copy">
      <p class="eyebrow teal">Now running</p>
      <h2 class="project-heading"><img src="/pharmulo-symbol.svg" alt="" width="48" height="52" />Pharmulo</h2>
      <p class="lead">An online storefront for pharmaceutical wholesalers.</p>
      <p>
        Pharmulo lets retailers browse stock and place orders online while fitting
        into the wholesale system the business already uses.
      </p>
      <a class="text-link" href="https://pharmulo.com" target="_blank" rel="noreferrer">
        Visit pharmulo.com <span aria-hidden="true">↗</span>
      </a>
    </div>
    <a class="product-window" href="https://pharmulo.com" target="_blank" rel="noreferrer" aria-label="Visit Pharmulo">
      <div class="window-bar" aria-hidden="true"><i></i><i></i><i></i><span>pharmulo.com</span></div>
      <img src="/pharmulo-home.webp" alt="Pharmulo website" width="1600" height="1000" loading="lazy" />
    </a>
  </section>

  <section class="product-feature logistics-feature">
    <div class="product-copy">
      <p class="eyebrow">Built for Naveen Logistics</p>
      <h2>Naveen Logistics</h2>
      <p class="lead">The paperwork behind every load, in one place.</p>
      <p>We built software for lorry receipts, freight bills, payments, and customer ledgers. Customers can sign in to check their documents and account statements.</p>
      <a class="text-link" href="https://www.naveenlogistics.com/" target="_blank" rel="noreferrer">Visit naveenlogistics.com <span aria-hidden="true">↗</span></a>
    </div>
    <a class="logistics-logo-panel" href="https://www.naveenlogistics.com/" target="_blank" rel="noreferrer" aria-label="Visit Naveen Logistics">
      <img src="/naveen-logistics-logo.png" alt="Naveen Logistics" width="512" height="512" loading="lazy" />
    </a>
  </section>

  <section class="closing-card">
    <h2>What does your work need?</h2>
    <p>Tell us what takes too long, what you still do by hand, or where your current tools fall short.</p>
    <a class="button dark" href="/contact">Get in touch</a>
  </section>
</BaseLayout>
