---
import BaseLayout from '../layouts/BaseLayout.astro';
import Talk from '../components/Talk.astro';
import contact from '../data/contact.json';
import logo from '../data/logo-paths.json';
import '../styles/home.css';

const wa = contact.whatsapp
  ? `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(contact.whatsappMessage)}`
  : `mailto:${contact.email}?subject=${encodeURIComponent(contact.emailSubject)}`;
const mail = `mailto:${contact.email}?subject=${encodeURIComponent(contact.emailSubject)}`;

// The mark's skeleton: the top hook, then the bowl. Stroked wide enough to cover
// the filled mark, used as a mask so the mark draws itself along its centreline.
const skeleton = {
  transform: 'translate(18 52) scale(5.073 4.786) translate(-19.5 -17.5)',
  // tuned: 40 is the minimum that covers the filled mark, 44 leaves a margin
  width: 44,
  hook: 'M35.5 25.2H53.6A19.6 19.6 0 0 1 73.2 44.8V72.3',
  bowl: 'M33.8 42.5A15.8 15.8 0 1 0 54.5 66.1',
};

const crops = [
  { x: -9, y: -6, ra: '20%', cw: 614, ch: 212, cs: 0.62, pos: '49.5% 34%' },
  { x: 9, y: -6, ra: '23%', cw: 186, ch: 56, cs: 1, pos: '12.4% 2.1%' },
  { x: 10, y: -2.2, ra: '26%', cw: 398, ch: 70, cs: 0.9, pos: '49.9% 69%' },
  { x: -10, y: 2.4, ra: '28%', cw: 356, ch: 212, cs: 0.74, pos: '20.3% 100%' },
  { x: 11, y: 2.4, ra: '32%', cw: 356, ch: 212, cs: 0.74, pos: '79.7% 100%' },
];
---

<BaseLayout
  title="Adiviath Technologies | Software built around your work"
  description="Adiviath builds and runs software for Indian businesses: Pharmulo for pharma wholesalers and custom systems like freight billing for Naveen Logistics."
>
  <div class="progress" aria-hidden="true"></div>
  <span class="fixed-dot" aria-hidden="true"></span>

  <section class="act act-1" aria-label="Introduction">
    <div class="stage">
      <div class="opening">
        <p class="eyebrow">Custom software for Indian businesses</p>
        <h1>Software built around the way your business works.</h1>
        <p class="lead">Adiviath builds and runs systems for operations where forms, spreadsheets and WhatsApp no longer keep up.</p>
        <div class="talk-actions">
          <a class="btn" href={wa}>Talk to the founder</a>
          <a class="btn-quiet" href={mail}>Prefer email? Write to {contact.email}</a>
        </div>
        <ul class="proof" aria-label="Proof">
          <li><strong>Pharmulo</strong>, live, built and operated by Adiviath</li>
          <li><strong>Naveen Logistics</strong>, custom system in production</li>
        </ul>
      </div>

      <div class="mark-only item" style="--ra:42%; --rb:95%">
        <svg class="mark-draw" viewBox="0 0 390 380" aria-hidden="true">
          <defs>
            <mask id="draw-1" maskUnits="userSpaceOnUse" x="0" y="0" width="390" height="380">
              <g fill="none" stroke="#fff" stroke-width={skeleton.width} stroke-linecap="round" stroke-linejoin="round" transform={skeleton.transform}>
                <path class="draw" pathLength="100" d={skeleton.hook} />
                <path class="draw" pathLength="100" d={skeleton.bowl} />
              </g>
            </mask>
          </defs>
          <path d={logo.mark} fill="currentColor" mask="url(#draw-1)" />
        </svg>
      </div>

      <p class="brandline item" style="--y:3; --ra:58%; --rb:99%">Your work. Your way. Your software.</p>
    </div>
    <p class="cue" aria-hidden="true">Scroll<i></i></p>
  </section>

  <section class="act act-2" aria-labelledby="pharmulo-h">
    <div class="stage">
      {crops.map((c) => (
        <div class="frame item" style={`--x:${c.x}; --y:${c.y}; --ra:${c.ra}; --rb:82%`}>
          <span class="crop" style={`--cw:${c.cw}; --ch:${c.ch}; --cs:${c.cs}; background-position: ${c.pos}`}></span>
        </div>
      ))}
      <div class="caption item" style="--y:8; --ra:34%; --rb:82%">
        <h2 id="pharmulo-h">Pharmulo. Built and operated by Adiviath. Live.</h2>
        <p>Wholesalers put their catalogue online; retailers order from any phone. Find stock, add quantity, send order.</p>
        <a class="btn-quiet" href="https://pharmulo.com" target="_blank" rel="noreferrer">See the work</a>
      </div>
    </div>
  </section>

  <section class="act act-3" aria-labelledby="naveen-h">
    <div class="stage">
      <h2 id="naveen-h" class="item" style="--y:-7; --ra:20%; --rb:82%">How the Naveen Logistics system connects the paperwork.</h2>
      <ol class="route" aria-label="Workflow">
        <li class="node item" style="--x:-8; --y:-3; --ra:24%; --rb:82%">Lorry receipt</li>
        <li class="node item" style="--x:8; --y:-3; --ra:27%; --rb:82%">Freight bill</li>
        <li class="node item" style="--x:-8; --y:4; --ra:30%; --rb:82%">Payment</li>
        <li class="node item" style="--x:8; --y:4; --ra:33%; --rb:82%">Settled account</li>
      </ol>
      <div class="item" style="--y:0.5; --ra:24%; --rb:82%">
        <svg class="wire" viewBox="0 0 800 400" preserveAspectRatio="none" aria-hidden="true">
          <path d="M120 150 H400 V150 H680 M680 150 V250 H400 V250 H120" pathLength="100" />
        </svg>
      </div>
      <div class="caption item" style="--y:9; --ra:38%; --rb:82%">
        <p>Custom software for Naveen Logistics. In production.</p>
        <a class="btn-quiet" href="https://www.naveenlogistics.com/" target="_blank" rel="noreferrer">See the work</a>
      </div>
    </div>
  </section>

  <section class="act act-4" aria-label="Talk to the founder">
    <div class="stage">
      <div class="item talk-wrap" style="--ra:20%; --rb:82%"><Talk variant="brand" /></div>
    </div>
  </section>

  <section class="act act-5" aria-label="Closing">
    <div class="stage">
      <div class="mark-only item" style="--ra:8%; --rb:40%">
        <svg class="mark-draw" viewBox="0 0 390 380" aria-hidden="true">
          <defs>
            <mask id="draw-5" maskUnits="userSpaceOnUse" x="0" y="0" width="390" height="380">
              <g fill="none" stroke="#fff" stroke-width={skeleton.width} stroke-linecap="round" stroke-linejoin="round" transform={skeleton.transform}>
                <path class="draw" pathLength="100" d={skeleton.hook} />
                <path class="draw" pathLength="100" d={skeleton.bowl} />
              </g>
            </mask>
          </defs>
          <path d={logo.mark} fill="currentColor" mask="url(#draw-5)" />
        </svg>
      </div>
      <div class="closing item" style="--y:7; --ra:20%; --rb:50%">
        <a class="btn" href={wa}>Talk to the founder</a>
        <p>Adiviath Technologies Private Limited. Registered in India.</p>
        <nav aria-label="Pages"><a href="/products">Work</a><a href="/about">About</a><a href="/contact">Contact</a></nav>
      </div>
    </div>
  </section>
</BaseLayout>
