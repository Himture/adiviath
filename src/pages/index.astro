---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Adiviath Technologies | Software made to fit"
  description="Adiviath Technologies builds focused software for specific real-world needs. Meet Pharmulo, our ordering platform for pharmaceutical wholesalers."
>
  <section class="hero">
    <div>
      <p class="eyebrow">Software made to fit</p>
      <h1>One real need.<br />One focused product.</h1>
      <p class="hero-copy">
        We build niche software around the way people actually work—small enough
        to stay focused, useful enough to matter every day.
      </p>
      <div class="actions">
        <a class="button" href="/products">See what we build</a>
        <a class="quiet-link" href="/about">Why Adiviath</a>
      </div>
    </div>
    <div class="fit-visual" aria-hidden="true">
      <span class="fit-ring fit-ring-one"></span>
      <span class="fit-ring fit-ring-two"></span>
      <img src="/adiviath-mark.png" alt="" width="390" height="356" />
      <p>Find the need.<br /><strong>Build the fit.</strong></p>
    </div>
  </section>

  <section class="intro-band">
    <p>We do not start with a category.</p>
    <h2>We start with work that deserves a better tool.</h2>
  </section>

  <section class="product-feature">
    <div class="product-copy">
      <p class="eyebrow teal">Now running</p>
      <h2>Pharmulo</h2>
      <p class="lead">A modern ordering storefront for pharmaceutical wholesalers.</p>
      <p>
        Pharmulo lets retailers browse stock and place orders online while fitting
        into the wholesale system the business already uses.
      </p>
      <a class="text-link" href="https://pharmulo.com" target="_blank" rel="noreferrer">
        Visit pharmulo.com <span aria-hidden="true">↗</span>
      </a>
    </div>
    <a class="product-window" href="https://pharmulo.com" target="_blank" rel="noreferrer" aria-label="Visit Pharmulo">
      <div class="window-bar" aria-hidden="true"><i></i><i></i><i></i><span>pharmulo.com</span></div>
      <img src="/pharmulo-home.webp" alt="Pharmulo website" width="1600" height="1000" loading="lazy" />
    </a>
  </section>

  <section class="closing-card">
    <p class="eyebrow">Adiviath Technologies</p>
    <h2>Specific by design.</h2>
    <p>The goal is not more software. It is the right software for the job.</p>
    <a class="button dark" href="/contact">Start a conversation</a>
  </section>
</BaseLayout>
