---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderForm from '../components/FounderForm.astro';
---

<BaseLayout path="/contact">
  <section class="section page-head joined">
    <div class="wrap">
      <h1>Talk to us</h1>
      <p class="sub">Tell us what's slow or broken today. We reply within one business day.</p>
    </div>
  </section>
  <FounderForm>
    <h2>Tell us how the work happens today</h2>
    <p class="build-lead">A short call is enough to know whether a product fits or a custom build makes sense.</p>
  </FounderForm>
</BaseLayout>
