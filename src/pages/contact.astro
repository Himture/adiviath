---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | Adiviath Technologies" description="Contact Adiviath Technologies about focused software and Pharmulo.">
  <section class="contact-hero">
    <div>
      <p class="eyebrow">Contact</p>
      <h1>Tell us where the work gets stuck.</h1>
    </div>
    <div class="contact-copy">
      <p>
        Tell us what you do and what is getting in the way. A few lines about
        the problem and the tools you use are enough to start.
      </p>
      <a class="button" href="mailto:hello@adiviath.com">hello@adiviath.com</a>
      <p class="contact-note">For product enquiries, visit <a href="https://pharmulo.com" target="_blank" rel="noreferrer">pharmulo.com</a>.</p>
    </div>
  </section>
</BaseLayout>
