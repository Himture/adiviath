---
import BaseLayout from '../layouts/BaseLayout.astro';
import Talk from '../components/Talk.astro';
import DotStage from '../components/DotStage.astro';
---

<BaseLayout title="Contact Adiviath Technologies | Talk to the founder" description="Tell the founder where work gets stuck: forms filled twice, registers kept by hand, reports nobody can pull. Replies within one business day.">
  <section class="section wrap">
    <h1>Tell us where the work gets stuck.</h1>
    <DotStage label="What your work might need">
      <div slot="n" class="dot-slot">a form someone fills twice</div>
      <div slot="e" class="dot-slot">a register kept by hand</div>
      <div slot="s" class="dot-slot">a report nobody can pull</div>
      <div slot="w" class="dot-slot you">your work</div>
    </DotStage>
  </section>
  <section class="wrap contact-talk">
    <Talk />
    <p class="muted contact-alt">Pharmulo enquiries: <a href="https://pharmulo.com" target="_blank" rel="noreferrer">pharmulo.com</a></p>
  </section>
</BaseLayout>
