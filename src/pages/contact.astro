---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderForm from '../components/FounderForm.astro';
---

<BaseLayout path="/contact">
  <section class="section page-head joined">
    <div class="wrap">
      <h1>Talk to us</h1>
      <p class="sub">Have a question or an idea for your business? Send us a message. We'll reply within one business day.</p>
    </div>
  </section>
  <FounderForm>
    <h2>What would make your work easier?</h2>
    <p class="build-lead">You don't need a detailed plan or technical terms. Tell us what you do and what you'd like to improve.</p>
  </FounderForm>
</BaseLayout>
