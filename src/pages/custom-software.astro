---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderForm from '../components/FounderForm.astro';
import { stepsHtml } from '../data/solutions';

const builds = ['Ordering and billing systems', 'Inventory and stock tracking', 'Customer and retailer portals', 'Android and iOS apps', 'Tally, Busy and Marg integrations', 'WhatsApp and SMS notifications', 'Dashboards and reports'];
const service = { '@type': 'Service', name: 'Custom business software', serviceType: 'Custom software development', provider: { '@id': `${new URL('/', Astro.site).href}#organization` }, areaServed: 'IN' };
---

<BaseLayout path="/custom-software" jsonLd={[service]}>
  <section class="section page-head">
    <div class="wrap">
      <h1>Custom software, built around how you already work</h1>
      <p class="sub">When existing software doesn't quite fit, we build a system for your business and support it after launch.</p>
      <a class="btn head-btn" href="/contact">Talk to us</a>
    </div>
  </section>
  <section class="section tint">
    <div class="wrap">
      <h2>What we build</h2>
      <ul class="build-list">{builds.map((b) => <li>{b}</li>)}</ul>
    </div>
  </section>
  <section class="section joined">
    <div class="wrap">
      <h2>How it works</h2>
      <Fragment set:html={stepsHtml} />
      <h2 class="dont">What we don't do</h2>
      <p class="dont-text">Our focus is software for day-to-day business operations. We don't build standalone informational websites.</p>
    </div>
  </section>
  <FounderForm interest="Something custom">
    <h2>Let's start with how you work</h2>
    <p class="build-lead">Tell us about your current process. Together, we can explore whether an existing product or a custom system is the right fit.</p>
  </FounderForm>
</BaseLayout>
