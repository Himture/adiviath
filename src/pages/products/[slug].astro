---
import BaseLayout from '../../layouts/BaseLayout.astro';
import products from '../../data/products.json';
import FounderForm from '../../components/FounderForm.astro';

type Testimonial = { quote: string; name: string; role: string; business: string };
export function getStaticPaths() { return products.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const testimonial = p.testimonial as Testimonial | null;
const site = new URL('/', Astro.site).href;
const app = { '@type': 'SoftwareApplication', name: p.name, applicationCategory: p.schema.applicationCategory, operatingSystem: p.schema.operatingSystem, description: p.detail, ...(p.url ? { url: p.url } : {}), publisher: { '@id': `${site}#organization` } };
---

<BaseLayout path={`/products/${p.slug}`} jsonLd={[app]}>
  <section class="section product">
    <div class="wrap product-grid">
      <div>
        <p class="card-tag petrol">Live · {p.audience}</p>
        <h1>{p.name}</h1>
        <p class="sub">{p.oneLiner}</p>
        <p class="detail">{p.detail}</p>
        {p.cta === 'external' && p.url ? <a class="btn" href={p.url} rel="noopener">Visit {new URL(p.url).hostname}</a> : <a class="btn" href={p.cta === 'form' ? '#enquiry' : '/contact'}>Talk to us</a>}
        {p.cta === 'external' && <p class="also">Questions first? <a class="link" href="/contact">Talk to us</a></p>}
      </div>
      {p.screenshot && <img src={p.screenshot.src} alt={p.screenshot.alt} width={p.screenshot.width} height={p.screenshot.height} fetchpriority="high" />}
    </div>
  </section>
  {testimonial && (
    <section class="section tint">
      <div class="wrap">
        <figure class="quote"><blockquote>“{testimonial.quote}”</blockquote><figcaption>{testimonial.name}, {testimonial.role}, {testimonial.business}</figcaption></figure>
      </div>
    </section>
  )}
  {p.cta === 'form' && (
    <FounderForm interest="Freight billing system">
      <h2>Tell us how the work happens today</h2>
      <p class="build-lead">A short call is enough to know whether this system fits your business.</p>
    </FounderForm>
  )}
</BaseLayout>
