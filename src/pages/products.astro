---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Products | Adiviath Technologies" description="Products built and operated by Adiviath Technologies, including Pharmulo.">
  <section class="page-hero">
    <p class="eyebrow">Products</p>
    <h1>Built around the work.</h1>
    <p>Each Adiviath product begins with a narrow, specific problem worth solving well.</p>
  </section>

  <section class="product-detail">
    <div class="product-identity">
      <span class="status"><i></i> Live product</span>
      <h2>Pharmulo</h2>
      <p>A modern ordering storefront for pharmaceutical wholesalers and their retailers.</p>
      <a class="button pharmulo" href="https://pharmulo.com" target="_blank" rel="noreferrer">Open Pharmulo</a>
    </div>
    <div class="product-points">
      <article><h3>Retailers browse</h3><p>Current stock is available from any phone, without circulating price lists.</p></article>
      <article><h3>They place the order</h3><p>Orders move out of calls, paper, and scattered message threads.</p></article>
      <article><h3>The workflow stays familiar</h3><p>Pharmulo works with the wholesale system the business already runs.</p></article>
    </div>
  </section>

  <section class="product-shot">
    <img src="/pharmulo-home.webp" alt="Pharmulo ordering storefront home page" width="1600" height="1000" />
  </section>
</BaseLayout>
