---
import Wordmark from './Wordmark.astro';
import company from '../data/company.json';
import pages from '../data/pages.json';
const links = ['/products', '/custom-software', '/about', '/contact'].map((p) => ({ href: p, label: pages.find((x) => x.path === p)?.nav ?? 'Contact' }));
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-layout">
    <div class="footer-brand"><a class="brand light" href="/" aria-label="Adiviath Technologies home"><Wordmark /></a><p class="since">Software products and custom systems<br />for your business.</p></div>
    <nav class="footer-nav" aria-label="Footer">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
    <div class="footer-contact"><a href={`mailto:${company.email}`}>{company.email}</a>{company.phone && <a href={`tel:${company.phone}`}>{company.phone}</a>}<p>Queries and grievances:<br />{company.grievance}</p><div class="footer-legal"><span class="copyright">© {year} {company.shortName}</span><nav aria-label="Legal"><a href="/privacy">Privacy</a><a href="/terms">Terms</a>{import.meta.env.PUBLIC_GA_ID && <button type="button" class="linkish" data-consent-open hidden>Cookie settings</button>}</nav></div></div>
    <div class="footer-company"><h2>Registered office</h2><p>{company.legalName}</p><p class="footer-address">{company.address.lines.map((line) => <span>{line}</span>)}</p><p>CIN {company.cin}</p></div>
  </div>
</footer>
