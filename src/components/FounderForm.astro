---
// The closing block on Home, custom software, solution, product and contact pages: whatever the page slots in (heading, steps),
// the founder note under it, and the contact form beside it.
import LeadForm from './LeadForm.astro';
import type { Lead } from '../lib/lead.ts';
interface Props { interest?: Lead['interest'] }
---
<section class="section enquiry" id="enquiry">
  <div class="wrap build">
    <div class="enquiry-copy">
      <slot />
      <div class="founder-note"><span class="founder-monogram" aria-hidden="true">HA</span><p>I read every message myself and reply within one business day.<strong>Himanshu Agarwal, Director</strong></p></div>
    </div>
    <div class="enquiry-action">
      <LeadForm interest={Astro.props.interest} />
    </div>
  </div>
</section>
